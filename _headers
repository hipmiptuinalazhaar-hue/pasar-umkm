# Static response hardening for Cloudflare Workers Assets.
# API responses are generated by Worker code and are not affected by this file.
#
# Freshness policy:
# - HTML, JS, and CSS may be stored locally but MUST revalidate before reuse.
#   This prevents long-lived mobile browser caches from serving stale product code
#   after a production deploy while still allowing efficient ETag/304 responses.
# - Media assets remain cacheable for longer because they are not executable UI code.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none
  Strict-Transport-Security: max-age=31536000
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self)
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; frame-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/checkout
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow

/checkout/*
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow

/purchases
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow

/purchases/*
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow

/seller-orders
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow

/seller-orders/*
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow

/support
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow

/support/*
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow

/admin
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self'; script-src 'self'; script-src-attr 'none'; connect-src 'self'; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'

/admin/*
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self'; script-src 'self'; script-src-attr 'none'; connect-src 'self'; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'

/js/admin/*
  Cache-Control: no-store, max-age=0

/css/admin-*
  Cache-Control: no-store, max-age=0

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
