{
  "name": "pasar-umkm",
  "main": "src/worker-entry.js",
  "compatibility_date": "2026-08-29",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
