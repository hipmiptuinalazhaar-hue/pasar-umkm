{
  "name": "pasar-umkm",
  "main": "src/seo-worker-entry.js",
  "compatibility_date": "2026-08-29",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/robots.txt",
      "/sitemap.xml",
      "/umkm/*",
      "/produk/*"
    ]
  },

  "ratelimits": [
    {
      "name": "EDGE_AUTH_LIMITER",
      "namespace_id": "12001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "EDGE_WRITE_LIMITER",
      "namespace_id": "12002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "EDGE_READ_LIMITER",
      "namespace_id": "12003",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],

  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
